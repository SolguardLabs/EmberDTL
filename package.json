    "verify:release": "node scripts/verify-release.mjs",
    "loc": "node scripts/check-loc.mjs",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.9.6"
  },
  "engines": {
    "node": ">=24"
  }
}
