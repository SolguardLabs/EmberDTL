{
  "name": "emberdtl",
  "version": "1.0.0",
  "private": true,
  "description": "Motor determinista de liquidación diferida, reservas e insurance por activo.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/build.mjs && node --test --experimental-strip-types \"tests/node/*.test.ts\"",
